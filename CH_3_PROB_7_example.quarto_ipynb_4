    " # import the packages we need:\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from data_fitting import *\n",
    "\n",
    "# make our lists:\n",
    "\n",
    "X = np.array([1,2, 3, 4, 5])\n",
    "Y = np.array([1, 1, 2, 2, 5])\n",
    "\n",
    "#############################\n",
    "##  1. WRITE FUNCTIONS     ##\n",
    "#############################\n",
    "\n",
    "fit2 = np.polyfit(X, Y, 2)\n",
    "fit1 = np.polyfit(X, Y, 1)\n",
    "\n",
    "x = np.linspace(0, 6, 1000)\n",
    "\n",
    "f2 = fit2[0]*x**2 + fit2[1]*x**1 + fit2[2]*x**0\n",
    "f1 = fit1[0]*x**1 + fit1[1]*x**0 \n",
    "\n",
    "def get_coeffs(X, Y, n):\n",
    "    \"\"\"\n",
    "    Takes the X and Y data, applies np.polyfit() for fit of chosen order n \n",
    "    and prints the elements neatly in form c_n = blahblahblah. \n",
    "    Each statement takes a line. Returns None.\n",
    "    \"\"\"\n",
    "    fit_list = np.polyfit(X, Y, n)\n",
    "\n",
    "    count = 0\n",
    "    cees = []\n",
    "\n",
    "    for numba in fit_list:\n",
    "        count += 1\n",
    "        cees.append(f'c_{count}')\n",
    "    \n",
    "    for numba, c in zip(fit_list, cees):\n",
    "        print(f'{c}={numba}')\n",
    "\n",
    "#############################\n",
    "##   2. PLOTS              ##\n",
    "#############################\n",
    "fig = plt.figure(figsize=(10,5))\n",
    "\n",
    "plt.subplot(1,2,1)\n",
    "plt.plot(x, f2)\n",
    "plt.scatter(X, Y)\n",
    "plt.title('$f(x)=c_1x^2+c_2x+c_3$')\n",
    "plt.legend()\n",
    "\n",
    "plt.subplot(1,2,2)\n",
    "plt.plot(x, f1)\n",
    "plt.scatter(X, Y)\n",
    "plt.title('$f(x)=c_1x+c_2$')\n",
    "plt.legend()\n",
    "\n",
    "F1 = fit1[0]*X**1 + fit1[1]*X**0\n",
    "F2 = fit2[0]*X**2 + fit2[1]*X**1 + fit2[2]*X**0\n",
    "\n",
    "'''\n",
    "polyfit returns an array of n+1 entries \n",
    "each corresponding to the coefficient of\n",
    "x**n.\n",
    "'''"
   ]
