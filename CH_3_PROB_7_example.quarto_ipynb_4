    " # import the packages we need:\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from data_fitting import *\n",
    "\n",
    "# make our lists:\n",
    "\n",
    "X = np.array([1,2, 3, 4, 5])\n",
    "Y = np.array([1, 1, 2, 2, 5])\n",
    "\n",
    "#############################\n",
    "##  1. WRITE FUNCTIONS     ##\n",
    "#############################\n",
    "\n",
    "fit2 = np.polyfit(X, Y, 2)\n",
    "fit1 = np.polyfit(X, Y, 1)\n",
    "\n",
    "x = np.linspace(0, 6, 1000)\n",
    "\n",
    "f2 = fit2[0]*x**2 + fit2[1]*x**1 + fit2[2]*x**0\n",
    "f1 = fit1[0]*x**1 + fit1[1]*x**0 \n",
    "\n",
    "#############################\n",
    "##   2. WRITE MODELS       ##\n",
    "#############################\n",
    "\n",
    "plt.plot(x, f2)\n",
    "plt.scatter(X, Y)\n",
    "\n",
    "plt.plot(x, f1)\n",
    "plt.scatter(X, Y)\n",
    "\n",
    "F1 = fit1[0]*X**1 + fit1[1]*X**0\n",
    "F2 = fit2[0]*X**2 + fit2[1]*X**1 + fit2[2]*X**0\n",
    "\n",
    "E1 = leastsquerror(Y, F1)\n",
    "E2 = leastsquerror(Y, F2)\n",
    "\n",
    "'''\n",
    "polyfit returns an array of n+1 entries \n",
    "each corresponding to the coefficient of\n",
    "x**n.\n",
    "'''"
